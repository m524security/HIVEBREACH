# HiveBreach Environment Configuration
HIVEBREACH_HOME=${PWD}
LOG_LEVEL=INFO
# LLM Routing
LLM_DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
NIM_BASE_URL=https://api.nvcf.nvidia.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Sandbox
DOCKER_NETWORK=hivebreach
SANDBOX_IMAGE=hivebreach-sandbox
# Vault
VAULT_KEY=
VAULT_EXPIRY_HOURS=24
# Audit
AUDIT_LOG_DIR=${HIVEBREACH_HOME}/sessions
AUDIT_HMAC_KEY=
# Scope
ROE_FILE=
SCOPE_MODE=strict
# ECC
ECC_HOOK_PROFILE=standard
